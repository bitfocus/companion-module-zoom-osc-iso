{
	"name": "zoom-osc-iso",
	"version": "5.0.0",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:icons": "node scripts/extract-layer-icons.mjs",
		"build:preset-icons": "node scripts/build-preset-icons.mjs",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"prettier": "prettier --write"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-zoom-osc-iso.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@fast-csv/parse": "^5.0.5",
		"osc": "^2.4.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.19.17",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"pngjs": "^7",
		"prettier": "^3.8.1",
		"rimraf": "^6.0.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.12"
	},
	"resolutions": {
		"osc/ws": "^8.22.2"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.13.0"
}
